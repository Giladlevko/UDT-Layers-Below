[sub_resource type="Resource" id="Resource_7mt04"]
script = ExtResource("2_4eged")
speaker = ExtResource("5_ku8lb")
lines = Array[String](["After more than 10 years... I found them...", "My two brothers... ", "They were explorers in this cave...", "We were triplets... ", "My mother always said we were a miracle, a gift from the heavens...", "They were always braver than I was. They liked exploring this cave more than anything...", "But I was always scared to go...", "One day they didn't return...", "Since then my mother stopped talking...", "She died a few years after... ", "The doctors said nothing was physically wrong....", "She simply lost the will to live...", "Why didn't I go with them?", "If I did my cautiousness would have saved us...", "The search teams never found them.. They said they were caved in too deep.", "I couldn't let it go... ", "I wanted them to have a proper burial... ", "I couldn't have let them stay in this cave...", "So I started searching myself.", "And now I found them...", "I can hear them... calling me to rescue them...", "But no matter what I try I cannot break through the rocks..", "If only I went with them that day... None of it would have happened..."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_hc6o5"]
script = ExtResource("1_hdnui")
Dialog = Array[ExtResource("2_4eged")]([SubResource("Resource_7mt04")])
metadata/_custom_type_script = "uid://bhqovwl8pw33d"

[sub_resource type="Resource" id="Resource_4sqb8"]
script = ExtResource("2_4eged")
speaker = ExtResource("5_ku8lb")
lines = Array[String](["Thank you.. You found them... ", "I was begining to lose hope...", "Now I can take them to a true resting place...", "I will bury them next to our mother...", "Perhaps now her soul can rest too...", "Thank you..."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_55d27"]
script = ExtResource("1_hdnui")
Dialog = Array[ExtResource("2_4eged")]([SubResource("Resource_4sqb8")])
metadata/_custom_type_script = "uid://bhqovwl8pw33d"

[sub_resource type="Resource" id="Resource_x62nf"]
script = ExtResource("2_4eged")
speaker = ExtResource("6_n5c2s")
lines = Array[String](["Why was I so foolish and irresponsible?", "How could I have given them that explorer permit...", "No knows where they are...", "The mining team were talking about an incident...", "Everyone is freaked out of their minds...", "If it's really what I think it is, it will be the first time in 80 years in this cave...", "People are starting to talk about closing the mine...", "Hundreds could lose their jobs...", "And they might not survive this at all...", "God... their poor family...", "I must resign... Its all my fault...", "When I know more I'll write to you again..."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_231fo"]
script = ExtResource("1_hdnui")
Dialog = Array[ExtResource("2_4eged")]([SubResource("Resource_x62nf")])
metadata/_custom_type_script = "uid://bhqovwl8pw33d"

[sub_resource type="Resource" id="Resource_tq7hp"]
script = ExtResource("2_4eged")
speaker = ExtResource("6_n5c2s")
lines = Array[String](["The mining team has been searching for three days...", "Based on what we know they are almost certainly dead at this point...", "Water can not be found this deep in the cave...", "No one can survive 3 days without water...", "It would take a miracle...", "The team has not rested...", "They have been searching this whole time...", "But they can't dig deep enough since it might collapse even more...", "I am waiting for your orders..."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_xa03u"]
script = ExtResource("1_hdnui")
Dialog = Array[ExtResource("2_4eged")]([SubResource("Resource_tq7hp")])
metadata/_custom_type_script = "uid://bhqovwl8pw33d"

[sub_resource type="Resource" id="Resource_y1cd3"]
script = ExtResource("2_4eged")
speaker = ExtResource("6_n5c2s")
lines = Array[String](["Weeks have passed and we still didn't find the bodies...", "We searched the entire cave...", "It's almost like they vanished into thin air...", "People are starting to believe they aren't ment to be found...", "They believe this is their resting place and that we should leave this cave for good...", "I remind them that the family needs a proper burial...", "But I don't think they listen.", "Should we call off the search?"])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_uj5wg"]
script = ExtResource("1_hdnui")
Dialog = Array[ExtResource("2_4eged")]([SubResource("Resource_y1cd3")])
metadata/_custom_type_script = "uid://bhqovwl8pw33d"

[sub_resource type="Resource" id="Resource_sa5ud"]
script = ExtResource("2_4eged")
speaker = ExtResource("6_n5c2s")
lines = Array[String](["Me and my brother have been trapped here for a couple of hours now...", "We are unsure we will get out of here...", "We can here the search parties digging all around us.", "We tried to scream but they can't hear us...", "Maybe we aren't meant to be rescued...", "We are starting to get thirsty and breathing is becoming harder...", "If this letter is ever found...", "Please tell our mother that we are sorry for not listening to her...", "for not being smart like our brother..."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_smhtd"]
script = ExtResource("1_hdnui")
Dialog = Array[ExtResource("2_4eged")]([SubResource("Resource_sa5ud")])
metadata/_custom_type_script = "uid://bhqovwl8pw33d"

[sub_resource type="Resource" id="Resource_ku8lb"]
script = ExtResource("2_4eged")
speaker = ExtResource("3_cthmq")
lines = Array[String](["Oh... Hello there young coal miner.", "I am old man Randy, but around here everyone just calls me old man...", "What is your name?"])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_n5c2s"]
script = ExtResource("2_4eged")
speaker = ExtResource("4_cthmq")
lines = Array[String](["I am 48-15"])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_cthmq"]
script = ExtResource("2_4eged")
speaker = ExtResource("3_cthmq")
lines = Array[String](["Well thats no name at all...", "I have been in these caves as long as I remember...  Around 80 years... ", "I used to be a coal miner as well... ", "but by the time miners like you were made, I made my way to management.", "I still blame myself for what happend here...", " That rueful day...", "How could I ever forget?", "I was incharge of the unit that...", "I'm sorry its too painful.", "Ever since I asked myself why it happened.", "I followed the procedural checks every day; it became a habit.", "So much so that I am not sure I followed them that day...", " but I must have...", "I still wonder if there was any way I could have prevented it...", "But I don't think there is anything I could have done...", "Its almost as if it had to happen...", "For a while now I felt I was dying.", "I wanted to help someone in the caves more than anything.", "Here in the mines Water is extremly rare...", "I came here to bring this water canteen to the one who needs it the most...", "But there are no more human workers here.", "I thought I'll find an explorer.", "And perhaps my water would help him enjoy this cave even longer.", "But I only found you...", "And you run on fuel... ", "I am unable to go further...", "There is nothing that would make me happier than to help someone in this cave...", "Would you take this canteen and give it to the one who needs it the most?"])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

