Dialog = Array[ExtResource("2_6wsn7")]([SubResource("Resource_g3hg8")])
metadata/_custom_type_script = "uid://bhqovwl8pw33d"

[sub_resource type="Resource" id="Resource_0cmj6"]
script = ExtResource("2_6wsn7")
speaker = ExtResource("3_33eh1")
lines = Array[String](["Hello Rusty, you are late... ", "I will be your supervisor today...", "That means you do what I tell you, no less no more.", "You got that bucket brain?", "We have a couple of shifts today...", "Each time I'll tell you the amount of coal we need to collect.", "By \"we\" I mean you... I got much more important things to do.", "I'm not a miner, I am a GREAT GUARDIAN HA HA!", "Far too important for coal mining.", "Anyway...", "This is you first day huh?", "You forgot your Jack Hammer....", "How can a miner forget his mining tool...", "Why do I always get the idiots...", "Good thing I got an extra...", "Well... ", "Your coal target for this shift is 100 coals", "You might find gems as well.", "If you do you can use it to upgrade your tools.", "You can find the upgrade shop in your system's menu.", "You can also see there your inventory and other useful things.", "You can see your coal collecting progress in that bar in the top right corner", "Other than that I think you are good to go...", "What are you waiting for oven brain get on to work!"])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_4smm7"]
script = ExtResource("1_uy80n")
Dialog = Array[ExtResource("2_6wsn7")]([SubResource("Resource_0cmj6")])
metadata/_custom_type_script = "uid://bhqovwl8pw33d"

[sub_resource type="Resource" id="Resource_dl71b"]
script = ExtResource("2_6wsn7")
speaker = ExtResource("3_33eh1")
lines = Array[String](["Look who decided to show up...", "Your break was far too long Rusty...", "You have no shame do  you?", "I can actually respect that...", "Maybe you aren't as bad after all huh?", "Anyway...", "The amount of coal you need to collect this time is...", "1500... no wait...", "150... Stupid handwriting... did you write this Rusty?", "well...", "Since I don't have time to wait around like last time, I brought you a little gift...", "This is a metal detector! ", "I tuned its settings so you will be able to find coal and gems with it.", "This should help you work faster right?", "You can switch between different tools with the mouse wheel.", "Or by pressing K...", "Well go on, you have lots of work to do..."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_0jqqa"]
script = ExtResource("1_uy80n")
Dialog = Array[ExtResource("2_6wsn7")]([SubResource("Resource_dl71b")])
metadata/_custom_type_script = "uid://bhqovwl8pw33d"

[sub_resource type="Resource" id="Resource_ysphk"]
script = ExtResource("2_6wsn7")
speaker = ExtResource("3_33eh1")
lines = Array[String](["Well you know the drill oven head...", "You better not keep me waiting again huh?", "The amount of coal you need to collect this time is 200.", "Easy enough, At least for me! HA HA!", "Well go on then..."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

