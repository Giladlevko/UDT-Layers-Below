[sub_resource type="Resource" id="Resource_grg5q"]
script = ExtResource("2_6wsn7")
speaker = ExtResource("3_33eh1")
lines = Array[String](["Well well well...", "I see you finished your assignment...", "Very good Rusty.", "One can expect much less from a Bucket brain like you.", "Believe me I have... ", "Anyway...", "Go on what are you waiting for?  Your next assignment is waiting..."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

