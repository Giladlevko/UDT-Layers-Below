[sub_resource type="Resource" id="Resource_vbyt2"]
script = ExtResource("2_6wsn7")
speaker = ExtResource("3_33eh1")
lines = Array[String](["There's my little Eager Beaver HA HA!", "You collected all of the required coal huh?", "Took you long enough...", "Come on. I'm not waiting any longer.", "Boss scheduled us another shift...", "That Rust Brain must really hate me...", "First he assigns me to deal with you, then another shift...", "If didn't need this job, I would've...", "Nevermind...", "Don't tell him I said that..."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

