[sub_resource type="Resource" id="Resource_m32d5"]
script = ExtResource("2_6wsn7")
speaker = ExtResource("3_33eh1")
lines = Array[String](["Finally... Please tell me you are finished...", "I can't wait to get out of this dump...", "It is more than suting for a lowly miner like yourself...", "But for a Beutiful, Powerful and great guardian like me?", "I deserve to be in a palce...", "No, wait. I deserve to have a palce! HA HA!", "Yes! I deserve to have faithful subjects. I desreve to be a King! HA HA!", "Well... ", "What are you doing just standing there?", "We don't have time to daydream. We have another shift..."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

