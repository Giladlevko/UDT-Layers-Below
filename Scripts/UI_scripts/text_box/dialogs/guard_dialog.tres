[sub_resource type="Resource" id="Resource_g3hg8"]
script = ExtResource("2_6wsn7")
speaker = ExtResource("3_33eh1")
lines = Array[String](["You're not going anywhere Rusty.", "What did you do until now huh?", "All this time and you're still short on coal", "You're also Short on height too huh?", "Thats why you are a lowly Miner.", "Where as I am a Beutiful Gaurdian ha ha ha! ", "Come back with more coal Tin Can "])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

[sub_resource type="Resource" id="Resource_1f5em"]
