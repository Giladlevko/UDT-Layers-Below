[sub_resource type="Resource" id="Resource_6wsn7"]
script = ExtResource("2_6wsn7")
speaker = ExtResource("3_33eh1")
lines = Array[String](["Where you think you're going Coal Collector?", "You don't have enough coal", "Can't let you pass Oven Head", "Bring me the needed coal, then we'll talk."])
metadata/_custom_type_script = "uid://bxrvun5bs65ck"

